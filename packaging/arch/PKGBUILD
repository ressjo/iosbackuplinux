# Maintainer: Joshua Ress
# Local PKGBUILD: run "makepkg -si" inside packaging/arch.
pkgname=iosbackuplinux
pkgver=0.2.0
pkgrel=1
pkgdesc="Back up, restore and browse iPhone and iPad backups over USB (libimobiledevice)"
arch=('any')
url="https://github.com/ressjo/iosbackuplinux"
license=('MIT')
depends=('python' 'pyside6' 'python-cryptography' 'libimobiledevice' 'usbmuxd')
optdepends=('kimageformats: HEIC thumbnails in the backup browser'
            'libheif: HEIC thumbnails via heif-dec if kimageformats lacks HEIF'
            'ffmpegthumbnailer: video thumbnails in the backup browser')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest')
source=()

_repo="$(realpath "${startdir}/../..")"

prepare() {
  rm -rf "${srcdir}/${pkgname}"
  mkdir -p "${srcdir}/${pkgname}"
  cp -r "${_repo}"/{src,tests,data,pyproject.toml,README.md,LICENSE} "${srcdir}/${pkgname}/"
}

build() {
  cd "${srcdir}/${pkgname}"
  python -m build --wheel --no-isolation
}

check() {
  cd "${srcdir}/${pkgname}"
  # GUI tests run without a display (offscreen); a simulated iPhone is provided by fake tools
  QT_QPA_PLATFORM=offscreen python -m pytest -q tests
}

package() {
  cd "${srcdir}/${pkgname}"
  python -m installer --destdir="${pkgdir}" dist/*.whl
  install -Dm644 data/iosbackuplinux.desktop "${pkgdir}/usr/share/applications/iosbackuplinux.desktop"
  install -Dm644 data/iosbackuplinux.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/iosbackuplinux.svg"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
